RewriteEngine On
RewriteBase /

# Baseline security headers.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # camera=(self) is deliberate: in-app capture uses getUserMedia.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
  Header always unset X-Powered-By
</IfModule>

# Never serve source, schema, or editor/backup leftovers. A .bak file is not parsed by PHP,
# so without this it would be sent as plain-text source.
<FilesMatch "\.(sql|sqlite3?|db|bak|old|orig|save|swp|log|env|sh|dist|lock)$|\.bak_|~$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ES module scripts need the right MIME type — some hosts default .mjs to text/plain.
<IfModule mod_mime.c>
  AddType application/javascript .mjs
</IfModule>

# The app shell and the service worker must never be cached, so a deploy takes effect at once.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# The front door. Next's static export answers "/" with an empty error shell that only
# performs the redirect once JS has hydrated; sending it here costs nothing and works
# without JS. 302, not 301 — browsers cache a 301 forever and the landing page may move.
RewriteRule ^$ /dashboard/ [R=302,L]

# API. Same origin as the app, so the browser needs no CORS at all — the API sends no CORS
# headers and answers OPTIONS with 404.
RewriteRule ^api/v1/?(.*)$ api/index.php?route=$1 [QSA,L]

# Serve a page's shell only when that page exists. Without the -f test a missing path
# rewrites to <path>/index.html, which also does not exist, and Apache stops the loop with a
# 500 — every typo would answer 500 instead of 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f [OR]
RewriteCond %{REQUEST_FILENAME}index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Anything left is genuinely missing.
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
